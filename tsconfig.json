{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["bun"]
	},
	"exclude": ["node_modules", "dist", ".next"]
}
