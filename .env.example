# --- Storage ----------------------------------------------------------------
DATABASE_URL=postgres://sonde:sonde@localhost:5432/sonde

# --- Venue: Alpaca paper only (ADR 0003, ADR 0024) --------------------------
# Paper credentials only. The adapter refuses to construct unless execution mode is `paper`.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
SONDE_EXECUTION_MODE=paper

# --- Source identity (ADR 0011) ---------------------------------------------
# Sent in every SEC User-Agent. Use an address you monitor.
SONDE_CONTACT_EMAIL=

# --- Strategy V1 policy (ADR 0020, ADR 0024) --------------------------------
# These mirror accepted launch policy. Runtime values belong to versioned policy snapshots so an
# environment change cannot rewrite the meaning of a prior decision.
SONDE_SIZING_TARGET_PCT=1
SONDE_POSITION_BREACH_PCT=1.25
SONDE_MAX_OPEN_POSITIONS=20
SONDE_MAX_SIC_POSITIONS=6

# --- Cockpit (ADR 0028) -----------------------------------------------------
# Required even on loopback. At least 16 characters. The browser never writes evidence.
SONDE_OPERATOR_TOKEN=
# Optional read-model URL. sonde_web can SELECT evidence and cannot insert, update, or delete it.
# DATABASE_URL=postgres://sonde_web:sonde_web@localhost:5432/sonde

# --- Later milestones --------------------------------------------------------
# Analyst provider credentials are added with the Milestone 6 provider adapter. There is no launch
# model dependency and no generic multi-provider key contract.
