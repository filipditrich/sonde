# --- Model access -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Storage ----------------------------------------------------------------
DATABASE_URL=postgres://sonde:sonde@localhost:5432/sonde

# --- Venue (paper / testnet only — see ADR 0003) ----------------------------
SONDE_VENUE=kraken-paper
SONDE_VENUE_API_KEY=
SONDE_VENUE_API_SECRET=

# Must be the literal string "paper" unless a live gate has been signed off.
SONDE_EXECUTION_MODE=paper

# --- Probes -----------------------------------------------------------------
# GDELT and most RSS feeds need no key.
SONDE_PROBE_FEEDS=

# --- Risk limits (hard caps, enforced in code — see ADR 0005) ---------------
SONDE_MAX_POSITION_PCT=2
SONDE_MAX_DAILY_LOSS_PCT=5
SONDE_MAX_ORDERS_PER_HOUR=20
