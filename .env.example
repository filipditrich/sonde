# --- Model access -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Storage ----------------------------------------------------------------
DATABASE_URL=postgres://sonde:sonde@localhost:5432/sonde

# --- Venue: Alpaca, paper only (ADR 0003, ADR 0014) -------------------------
# Paper keys from the Alpaca dashboard. Live keys must never appear here.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Must be the literal string "paper". The venue adapter refuses to construct
# in any other mode; changing this needs an ADR superseding 0003.
SONDE_EXECUTION_MODE=paper

# --- Source identity (ADR 0011) ---------------------------------------------
# SEC returns 403 to any client that does not declare a contact. Sent in the
# User-Agent on every SEC request, per their fair-access policy.
SONDE_CONTACT_EMAIL=

# --- Probes -----------------------------------------------------------------
# GDELT, FRED and the Bluesky firehose need no key.
SONDE_PROBE_FEEDS=

# --- Risk limits (hard caps, enforced in code — ADR 0005) -------------------
SONDE_MAX_POSITION_PCT=2
SONDE_MAX_DAILY_LOSS_PCT=5
SONDE_MAX_ORDERS_PER_HOUR=20
# Reject a thesis if the open gaps beyond this from its reference price.
# Placeholder — the A4 spike exists to replace this with a measured value.
SONDE_MAX_ENTRY_GAP_PCT=4
